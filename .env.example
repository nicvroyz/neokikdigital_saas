# Neokik Digital SaaS - Root Environment Variables (for Docker Compose Setup)

# Database
DB_USER=neokik_admin
DB_PASSWORD=StrongPassword123!
DB_NAME=neokik_saas

# Security
JWT_SECRET=neokik_super_secret_jwt_key_2026

# Execution Mode
# Set to false in production to execute real docker commands, Mailcow requests, Caddy configs, and database operations.
# IMPORTANT: while this is "true" (default), all Mailcow email data (mailboxes, quotas, creation, deletion) is SIMULATED.
MIGRATION_DRY_RUN=true

# Database Container (used by DatabaseService in production to execute commands)
MYSQL_CONTAINER_NAME=neokik-mysql

# memory_limit applied ONLY to individual PHP/WP-CLI calls made by the migration
# engine (DB connectivity checks, health checks, search-replace, cache flush) -
# never the container's global php.ini memory_limit. Defaults to 1024M if unset.
MIGRATION_PHP_MEMORY_LIMIT=1024M

# Mailcow API Integration requirement (set to false to warn but not fail site migrations if Mailcow is down)
MAILCOW_REQUIRED=false

# Mailcow API (required for real email management once MIGRATION_DRY_RUN=false)
MAILCOW_API_URL=https://mail.tdd.cl
MAILCOW_API_KEY=your-mailcow-api-key-here

# Public URL of the Mailcow webmail host, if different from MAILCOW_API_URL (rarely needed)
MAILCOW_WEBMAIL_URL=https://mail.tdd.cl

# Webmail SSO bridge (see docs/WEBMAIL_SSO.md and infra/mailcow/sogo-auth.php).
# MUST match NEOKIK_WEBMAIL_SSO_SECRET set on the Mailcow host. Generate with:
#   openssl rand -hex 32
# Leave empty to disable the "Abrir Webmail" button (fails closed, not open).
WEBMAIL_SSO_SECRET=
